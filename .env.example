# Required for Google Cloud Vision API
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Supabase Configuration 
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-from-supabase

# SerpAPI Configuration
SERP_API_KEY=your-serpapi-key

# JWT Configuration for API auth
JWT_SECRET=your-secure-secret-key

# API Configuration
PORT=8000
HOST=0.0.0.0

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# ClipDrop API key for background removal
CLIPDROP_API_KEY=your_clipdrop_api_key

# Imagine.art API key for image to video conversion
IMAGINE_ART_API_KEY=your_imagine_art_api_key

# SightEngine API credentials for AI detection
SIGHTENGINE_API_USER=your_sightengine_api_user
SIGHTENGINE_API_SECRET=your_sightengine_api_secret

# Google Cloud credentials
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_API_KEY=your_google_api_key # Optional, for Gemini API (alternative to using ADC) 